# Toggle: true = serve mock data, false = query real Vicidial MySQL
MOCK_MODE=true

# Vicidial MySQL (provided by client's admin — read-only user)
VICIDIAL_HOST=
VICIDIAL_PORT=3306
VICIDIAL_USER=
VICIDIAL_PASSWORD=
VICIDIAL_DB=asterisk

# DISPO codes — confirm exact strings with the client's admin
DISPO_SALE=SALE
DISPO_CALLBACK=CALLBK

# Supabase (cache layer — service role key, this is a worker)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Claude API (for weekly summaries — Haiku)
ANTHROPIC_API_KEY=

# CORS — Base44 app origin
ALLOWED_ORIGIN=https://app.base44.com

# Bearer token Base44 must send on every request: Authorization: Bearer <token>
# Generate locally with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=
